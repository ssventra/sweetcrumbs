{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sweetcrumb.example/contracts/menu.schema.json",
  "title": "Sweet Crumb Bakery menu file (site/data/menu.json)",
  "description": "Structural contract. Semantic rules that JSON Schema cannot express (unique ids, image file exists, open < close, valid IANA time zone, 'daily' not combined with weekdays, max 2 decimal places) are enforced by menu-check; see data-model.md.",
  "type": "object",
  "required": ["business", "items"],
  "additionalProperties": false,
  "properties": {
    "business": {
      "type": "object",
      "required": ["name", "tagline", "phone", "email", "address", "map", "timeZone", "hours", "leadTimes"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "tagline": { "type": "string", "minLength": 1 },
        "phone": { "type": "string", "pattern": "^[0-9()+\\-. ]{7,20}$" },
        "email": { "type": "string", "format": "email" },
        "address": {
          "type": "object",
          "required": ["street", "city", "region", "postalCode"],
          "additionalProperties": false,
          "properties": {
            "street": { "type": "string", "minLength": 1 },
            "city": { "type": "string", "minLength": 1 },
            "region": { "type": "string", "minLength": 1 },
            "postalCode": { "type": "string", "minLength": 1 }
          }
        },
        "map": {
          "type": "object",
          "required": ["lat", "lon"],
          "additionalProperties": false,
          "properties": {
            "lat": { "type": "number", "minimum": -90, "maximum": 90 },
            "lon": { "type": "number", "minimum": -180, "maximum": 180 },
            "zoom": { "type": "integer", "minimum": 1, "maximum": 19, "default": 16 }
          }
        },
        "timeZone": { "type": "string", "minLength": 1, "examples": ["America/New_York"] },
        "hours": {
          "type": "object",
          "required": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"],
          "additionalProperties": false,
          "properties": {
            "mon": { "$ref": "#/$defs/dayHours" },
            "tue": { "$ref": "#/$defs/dayHours" },
            "wed": { "$ref": "#/$defs/dayHours" },
            "thu": { "$ref": "#/$defs/dayHours" },
            "fri": { "$ref": "#/$defs/dayHours" },
            "sat": { "$ref": "#/$defs/dayHours" },
            "sun": { "$ref": "#/$defs/dayHours" }
          }
        },
        "leadTimes": {
          "type": "object",
          "required": ["preorderHours", "cakeHours"],
          "additionalProperties": false,
          "properties": {
            "preorderHours": { "type": "integer", "minimum": 0, "default": 24 },
            "cakeHours": { "type": "integer", "minimum": 0, "default": 72 }
          }
        },
        "cakeFormEndpoint": {
          "type": "string",
          "anyOf": [{ "const": "" }, { "pattern": "^https://" }]
        },
        "announcement": { "type": "string", "maxLength": 280 }
      }
    },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/menuItem" }
    }
  },
  "$defs": {
    "time": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
    "dayHours": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["open", "close"],
          "additionalProperties": false,
          "properties": {
            "open": { "$ref": "#/$defs/time" },
            "close": { "$ref": "#/$defs/time" }
          }
        }
      ]
    },
    "menuItem": {
      "type": "object",
      "required": ["id", "name", "category", "price"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "category": {
          "type": "string",
          "description": "Known: breads, pastries, cakes, cookies. Other values pass the schema but menu-check warns and the site shows them under 'Other'."
        },
        "description": { "type": "string", "maxLength": 200 },
        "price": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "type": "string", "maxLength": 24 },
        "image": { "type": "string", "pattern": "^assets/img/[a-z0-9-]+\\.webp$" },
        "imageAlt": { "type": "string", "minLength": 1 },
        "allergens": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 },
          "description": "Known: milk, eggs, wheat, soy, peanuts, tree-nuts, sesame. Unknown values allowed (warning)."
        },
        "soldOut": { "type": "boolean", "default": false },
        "featured": { "type": "boolean", "default": false },
        "specialDays": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["daily", "mon", "tue", "wed", "thu", "fri", "sat", "sun"] }
        }
      },
      "dependentRequired": { "image": ["imageAlt"] }
    }
  }
}
