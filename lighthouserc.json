{
  "ci": {
    "collect": {
      "staticDistDir": "site",
      "numberOfRuns": 3,
      "url": [
        "index.html",
        "menu.html",
        "about.html",
        "custom-cakes.html",
        "visit.html",
        "preorder.html"
      ]
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 1 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
